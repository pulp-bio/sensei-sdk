/dts-v1/;
#include <nordic/nrf5340_cpuapp_qkaa.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#include <zephyr/dt-bindings/led/led.h>

/ {
	model = "NRF5340 SENSEIv1 Application";
	compatible = "eth-zurich,nrf5340-senseiv1-cpuapp";

	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,uart-mcumgr = &cdc_acm_uart0;
		zephyr,bt-mon-uart = &cdc_acm_uart0;
		zephyr,bt-c2h-uart = &cdc_acm_uart0;
		zephyr,bt-uart = &cdc_acm_uart0;
		zephyr,bt-hci-ipc = &ipc0;
		nordic,802154-spinel-ipc = &ipc0;
		zephyr,ieee802154 = &ieee802154;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};


	zephyr,user {
		/* adjust channel number according to pinmux in board.dts */
		io-channels = <&adc 0>;
	};

	aliases {
		i2ca = &i2c0;
		i2cb = &i2c1;
		spia = &spi4;
		spib = &spi2;
		//uartgap = &uart_gap;
	};
	buttons{
		gpio_lis2duxs12_int1: gpio_lis2duxs12_int1 {
			gpios = <&gpio0 23 GPIO_ACTIVE_HIGH>;
			label = "LIS2DUXS12_INT";
		};
		/* Active low: reset is requested when the line is pulled to GND.
		 * Internal pull-up keeps the line high while idle. */
		gpio_soft_rst: gpio_soft_rst {
			gpios = <&gpio0 26 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "BUTTON_SOFT_INT";
		};
	};
};

#include "nrf5340_senseiv1_shared.dtsi"

&pinctrl {
	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 2)>,
				<NRF_PSEL(TWIM_SDA, 1, 3)>;
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 2)>,
				<NRF_PSEL(TWIM_SDA, 1, 3)>;
			low-power-enable;
		};
	};

	i2c1_default: i2c1_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 10)>,
				<NRF_PSEL(TWIM_SDA, 0, 24)>;
		};
	};

	i2c1_sleep: i2c1_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 10)>,
				<NRF_PSEL(TWIM_SDA, 0, 24)>;
			low-power-enable;
		};
	};

	/* SPI_A (board-to-board J2 pins 29/31/34, CS on P0.11 as GPIO).
	 * P0.08-P0.11 are the nRF5340 dedicated high-speed pins: on SPIM4
	 * this bus supports up to 32 MHz ("SPI A is the high-speed SPI"). */
	spi_a_default: spi_a_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
				<NRF_PSEL(SPIM_MOSI, 0, 9)>,
				<NRF_PSEL(SPIM_MISO, 0, 10)>;
		};
	};

	spi_a_sleep: spi_a_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
				<NRF_PSEL(SPIM_MOSI, 0, 9)>,
				<NRF_PSEL(SPIM_MISO, 0, 10)>;
			low-power-enable;
		};
	};

	/* SPI_B (board-to-board J2 pins 24-27, CS on P1.08), max 8 MHz. */
	spi_b_default: spi_b_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 7)>,
				<NRF_PSEL(SPIM_MOSI, 0, 30)>,
				<NRF_PSEL(SPIM_MISO, 0, 29)>;
		};
	};

	spi_b_sleep: spi_b_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 7)>,
				<NRF_PSEL(SPIM_MOSI, 0, 30)>,
				<NRF_PSEL(SPIM_MISO, 0, 29)>;
			low-power-enable;
		};
	};

	//uart_gap_default: uart0_default {
	//group1 {
	//		psels = <NRF_PSEL(UART_TX, 1, 0)>,
	//			<NRF_PSEL(UART_RX, 1, 1)>;
	//	};
	//};

	//uart_gap_sleep: uart0_sleep {
	//	group1 {
	//		psels = <NRF_PSEL(UART_TX, 1, 0)>,
	//			<NRF_PSEL(UART_RX, 1, 1)>;
	//		low-power-enable;
	//	};
	//};
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&adc {
	status = "okay";
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <3600>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN3>; /* P0.07 for nRF5340 */
		zephyr,resolution = <12>;
	};
};


&i2c0 {
	compatible = "nordic,nrf-twim";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";
};

&i2c1 {
	compatible = "nordic,nrf-twim";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";
};

/* SPI_A: always-available shield bus on SPIM4, the only 32 MHz-capable
 * SPI instance of the nRF5340. Used by the ExG/EMG shields (ADS1298,
 * CS via GPIO P0.11/P1.09) and foreseen for WiFi/mmWave shields.
 * Chip selects are per-device GPIOs, not cs-gpios here, because several
 * shields share the bus and the application arbitrates access. */
spi_a: &spi4 {
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi_a_default>;
	pinctrl-1 = <&spi_a_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";
};

/* SPI_B: always-available shield bus on SPIM2 (max 8 MHz). Used by the
 * US/WULPUS shield (MSP430, CS P1.08). Occupies serial-box 2, so i2c2
 * and uart2 must stay disabled; serial-box 3 (uart3) is kept free for
 * the GAP9 UART. */
spi_b: &spi2 {
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi_b_default>;
	pinctrl-1 = <&spi_b_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";
};

&i2c2 {
	status = "disabled";	/* serial-box 2 is used by SPI_B */
};

&uart2 {
	status = "disabled";	/* serial-box 2 is used by SPI_B */
};

&i2c0 {
	led_0: is31fl3194@53 {
		compatible = "issi,is31fl3194";
		reg = <0x53>;

		leds {
			label = "RGB LED";
			color-mapping =
				<LED_COLOR_ID_RED>,
				<LED_COLOR_ID_GREEN>,
				<LED_COLOR_ID_BLUE>;
			current-limit = <10>;
		};
	  };
};

//uart_gap: &uart3{
//	status = "okay";
//	current-speed = <115200>;

//	pinctrl-0 = <&uart_gap_default>;
//	pinctrl-1 = <&uart_gap_sleep>;
//	pinctrl-names = "default", "sleep";
//};

&ieee802154 {
	status = "okay";
};

zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};


&rtt0 {
    status = "okay";
};

&rtc0 {
	status = "okay";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x0 0x10000>;
		};
		slot0_partition: partition@10000 {
			label = "image-0";
			reg = <0x10000 0x70000>;
		};
		slot1_partition: partition@80000 {
			label = "image-1";
			reg = <0x80000 0x70000>;
		};
		scratch_partition: partition@f0000 {
			label = "image-scratch";
			reg = <0xf0000 0xa000>;
		};
		storage_partition: partition@fa000 {
			label = "storage";
			reg = <0xfa000 0x6000>;
		};
	};
};


